---
import '../styles/global.css';
import ProductCard from '../components/ProductCard.astro';

const products = [
  {
    emoji: "💊",
    name: "Imunosal® kapsule",
    subtitle: "Kapsule za imunitet",
    audience: "Odrasli i djeca 12+",
    highlight: false,
  },
  {
    emoji: "🧴",
    name: "Imunosal® tekući dodatak prehrani",
    subtitle: "Tekući oblik za djecu",
    audience: "Predškolska i školska djeca",
    badge: "Za djecu",
    highlight: false,
  },
  {
    emoji: "🍯",
    name: "Imunosal® Junior sirup",
    subtitle: "Sirup slatkog okusa",
    audience: "Djeca od 1 godine",
    badge: "Najmlađi",
    highlight: false,
  },
  {
    emoji: "🌿",
    name: "Imunosal® Senior kapsule",
    subtitle: "Formula za zrelu dob",
    audience: "50+ godina",
    badge: "Senior",
    highlight: false,
  },
  {
    emoji: "⚡",
    name: "Imunosal® C-1000 kapsule",
    subtitle: "1000 mg vitamina C",
    audience: "Odrasli i djeca 12+",
    highlight: true,
  },
  {
    emoji: "🫧",
    name: "Imunosal® šumeće tablete",
    subtitle: "Osvježavajući šumeći oblik",
    audience: "Djeca 6+ i odrasli",
    highlight: false,
  },
  {
    emoji: "📦",
    name: "Imunosal® Direkt",
    subtitle: "Direktne vrećice – bez vode",
    audience: "Odrasli i djeca 12+",
    badge: "Praktično",
    highlight: false,
  },
  {
    emoji: "🍬",
    name: "Imunosal® pastile",
    subtitle: "Pastile ugodnog okusa",
    audience: "Djeca od 3 godine",
    highlight: false,
  },
];

const benefits = [
  {
    icon: "🔬",
    title: "Beta-glucan snaga",
    description: "Visoko pročišćeni beta-(1,3/1,6)-D-glukan iz kvasca Saccharomyces cerevisiae – klinički istražena aktivna tvar za potporu imunitetu.",
  },
  {
    icon: "☀️",
    title: "Vitamin D3V®",
    description: "Patentirani prirodni kolekalciferol dobiven iz biljnog izvora. Jedinstven brend koji garantira čistoću i bioraspoloživost.",
  },
  {
    icon: "👨‍👩‍👧‍👦",
    title: "Za cijelu obitelj",
    description: "Od sirupa za bebiće od 1. godine do formula za 50+ – Imunosal® ima odgovarajući oblik za svaki životni stadij.",
  },
  {
    icon: "🏆",
    title: "Broj 1 u ljekarnama",
    description: "Najprodavaniji brand dodataka prehrani za imunitet u hrvatskim ljekarnama prema IQVIA podacima za 2020. i 2021. godinu.",
  },
];

const ingredients = ["Beta-(1,3/1,6)-D-glukan", "Vitamin D3V®", "Vitamin C", "Cink (Zinc)", "CoQ10", "Vitamini B kompleksa"];
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Imunosal® – broj 1 brand za potporu imunitetu u hrvatskim ljekarnama. Visoko pročišćeni beta-glukan, Vitamin D3V® i kompleks vitamina za cijelu obitelj." />
  <meta name="generator" content={Astro.generator} />
  <title>Imunosal® – Snaga prirodnog imuniteta | PHARMOVAL®</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body class="antialiased">

  <!-- NAVIGATION -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200/60 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-[#1B4F8A] to-[#2563af] flex items-center justify-center">
            <span class="text-white text-xs font-black">I</span>
          </div>
          <span class="font-black text-[#1B4F8A] text-xl tracking-tight">Imunosal<sup class="text-xs font-bold">®</sup></span>
        </div>
        <div class="hidden md:flex items-center gap-8">
          <a href="#prednosti" class="text-slate-600 hover:text-[#1B4F8A] text-sm font-medium transition-colors">Prednosti</a>
          <a href="#proizvodi" class="text-slate-600 hover:text-[#1B4F8A] text-sm font-medium transition-colors">Proizvodi</a>
          <a href="#znanost" class="text-slate-600 hover:text-[#1B4F8A] text-sm font-medium transition-colors">Znanost</a>
          <a href="#povjerenje" class="text-slate-600 hover:text-[#1B4F8A] text-sm font-medium transition-colors">Povjerenje</a>
        </div>
        <a
          href="https://www.drogerija.hr"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-[#1B4F8A] hover:bg-[#143d6b] text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors"
        >
          Kupi online
        </a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section class="relative min-h-screen flex items-center overflow-hidden bg-gradient-to-br from-[#0d2d52] via-[#1B4F8A] to-[#1e6fb5] pt-16">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -right-40 w-96 h-96 rounded-full bg-[#2ECC71]/10 blur-3xl"></div>
      <div class="absolute top-1/2 -left-20 w-64 h-64 rounded-full bg-white/5 blur-2xl"></div>
      <div class="absolute bottom-20 right-1/4 w-48 h-48 rounded-full bg-[#2ECC71]/15 blur-2xl"></div>
      <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 32px 32px;"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-[#2ECC71]/20 border border-[#2ECC71]/30 text-[#2ECC71] rounded-full px-4 py-1.5 text-sm font-semibold mb-8">
          <span class="w-2 h-2 rounded-full bg-[#2ECC71] animate-pulse"></span>
          Broj 1 u hrvatskim ljekarnama &bull; IQVIA 2020 &amp; 2021
        </div>

        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black text-white leading-[1.05] tracking-tight mb-6">
          Snaga<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#2ECC71] to-[#5ddb95]">prirodnog</span><br />
          imuniteta
        </h1>

        <p class="text-lg sm:text-xl text-blue-100 leading-relaxed mb-10 max-w-xl">
          Imunosal® &mdash; visoko pročišćeni beta-glukan iz kvasca, obogaćen vitaminima, mineralima i jedinstvenim vitaminom D3V® za sveobuhvatnu zaštitu imunološkog sustava vaše obitelji.
        </p>

        <div class="flex flex-wrap gap-4">
          <a
            href="#proizvodi"
            class="inline-flex items-center gap-2 bg-[#2ECC71] hover:bg-[#27ae60] text-white font-bold px-7 py-3.5 rounded-xl transition-all duration-200 hover:shadow-lg hover:-translate-y-0.5"
          >
            Pogledaj proizvode
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href="#znanost"
            class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold px-7 py-3.5 rounded-xl transition-all duration-200"
          >
            Saznaite više
          </a>
        </div>

        <div class="flex flex-wrap gap-8 mt-14 pt-10 border-t border-white/10">
          <div>
            <div class="text-3xl font-black text-white">8</div>
            <div class="text-blue-200 text-sm mt-0.5">oblika proizvoda</div>
          </div>
          <div class="w-px bg-white/20 hidden sm:block"></div>
          <div>
            <div class="text-3xl font-black text-white">#1</div>
            <div class="text-blue-200 text-sm mt-0.5">u ljekarnama</div>
          </div>
          <div class="w-px bg-white/20 hidden sm:block"></div>
          <div>
            <div class="text-3xl font-black text-white">1+</div>
            <div class="text-blue-200 text-sm mt-0.5">od 1. godine života</div>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" preserveAspectRatio="none">
        <path d="M0 80H1440V40C1200 80 960 20 720 40C480 60 240 20 0 40V80Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- KEY BENEFITS -->
  <section id="prednosti" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-[#2ECC71] font-bold text-sm uppercase tracking-widest mb-3">Zašto Imunosal®</p>
        <h2 class="text-4xl sm:text-5xl font-black text-slate-900 tracking-tight">Vrhunska formula,<br />dokazana učinkovitost</h2>
        <p class="text-slate-500 text-lg mt-4 max-w-xl mx-auto">Svaki sastojak odabran je s razlogom &ndash; za maksimalnu potporu vašem imunološkom sustavu.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {benefits.map((benefit) => (
          <div class="group p-7 rounded-2xl border border-slate-200 hover:border-[#1B4F8A]/30 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 bg-white">
            <div class="text-4xl mb-5 group-hover:scale-110 transition-transform duration-300">{benefit.icon}</div>
            <h3 class="font-bold text-[#1B4F8A] text-lg mb-3">{benefit.title}</h3>
            <p class="text-slate-500 text-sm leading-relaxed">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section id="proizvodi" class="py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-[#2ECC71] font-bold text-sm uppercase tracking-widest mb-3">Naša ponuda</p>
        <h2 class="text-4xl sm:text-5xl font-black text-slate-900 tracking-tight">Imunosal® za<br />svaku dob i potrebu</h2>
        <p class="text-slate-500 text-lg mt-4 max-w-xl mx-auto">Od beba do seniora &ndash; cijela obitelj zaslužuje kvalitetnu zaštitu imuniteta.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {products.map((product) => (
          <ProductCard
            emoji={product.emoji}
            name={product.name}
            subtitle={product.subtitle}
            audience={product.audience}
            badge={product.badge}
            highlight={product.highlight}
          />
        ))}
      </div>

      <div class="mt-12 text-center">
        <p class="text-slate-500 text-sm mb-5">Dostupno u svim ljekarnama i online</p>
        <a
          href="https://www.drogerija.hr"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#1B4F8A] hover:bg-[#143d6b] text-white font-bold px-8 py-4 rounded-xl transition-all duration-200 hover:shadow-lg hover:-translate-y-0.5"
        >
          Kupi na drogerija.hr
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SCIENCE / INGREDIENTS -->
  <section id="znanost" class="py-24 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-[#2ECC71] font-bold text-sm uppercase tracking-widest mb-3">Djelatna tvar</p>
          <h2 class="text-4xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight mb-6">
            Beta-glukan &ndash;<br />
            <span class="text-[#1B4F8A]">prirodni aktivator</span><br />
            imuniteta
          </h2>
          <p class="text-slate-600 leading-relaxed mb-6">
            Beta-(1,3/1,6)-D-glukan je polisaharid koji se prirodno nalazi u staničnoj stijenci kvasca <em>Saccharomyces cerevisiae</em>. Kroz proces visoke pročišćenosti, Imunosal® osigurava maksimalnu bioraspoloživost ove iznimne djelatne tvari.
          </p>
          <p class="text-slate-600 leading-relaxed mb-8">
            Beta-glukani prepoznati su u brojnim kliničkim istraživanjima kao modulatori imunološkog odgovora koji aktiviraju makrofage, NK stanice i neutrofile &mdash; ključne obrambene stanice vašeg tijela.
          </p>

          <div class="flex flex-wrap gap-2 mb-8">
            {ingredients.map((ing) => (
              <span class="bg-[#1B4F8A]/8 text-[#1B4F8A] border border-[#1B4F8A]/20 text-sm font-medium px-3 py-1.5 rounded-full">
                {ing}
              </span>
            ))}
          </div>

          <div class="bg-gradient-to-r from-[#f0fdf4] to-white border border-[#2ECC71]/30 rounded-2xl p-5">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-xl bg-[#2ECC71]/15 flex items-center justify-center shrink-0 text-xl">☀️</div>
              <div>
                <h4 class="font-bold text-slate-800 text-sm mb-1">Vitamin D3V® &mdash; jedinstven u svijetu</h4>
                <p class="text-slate-500 text-sm leading-relaxed">Prirodni kolekalciferol iz biljnog izvora, brend koji garantira čistoću i izvor. Imunosal® je jedan od rijetkih proizvoda koji koristi ovu patentiranu formu vitamina D.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-[#1B4F8A] to-[#0d2d52] p-10 shadow-2xl">
            <div class="absolute top-0 right-0 w-40 h-40 rounded-full bg-[#2ECC71]/10 -translate-y-1/2 translate-x-1/2"></div>
            <div class="absolute bottom-0 left-0 w-32 h-32 rounded-full bg-white/5 translate-y-1/2 -translate-x-1/2"></div>
            <div class="relative z-10">
              <div class="text-6xl mb-6">🔬</div>
              <h3 class="text-white font-black text-2xl mb-4">Klinički istraženo</h3>
              <div class="space-y-4">
                <div class="flex items-center gap-4 bg-white/10 rounded-xl p-4">
                  <div class="text-[#2ECC71] font-black text-2xl w-16 shrink-0">92%</div>
                  <div class="text-blue-100 text-sm leading-snug">korisnika primijetilo jači imunitet</div>
                </div>
                <div class="flex items-center gap-4 bg-white/10 rounded-xl p-4">
                  <div class="text-[#2ECC71] font-black text-2xl w-16 shrink-0">3x</div>
                  <div class="text-blue-100 text-sm leading-snug">aktivacija prirodnih obrambenih stanica</div>
                </div>
                <div class="flex items-center gap-4 bg-white/10 rounded-xl p-4">
                  <div class="text-[#2ECC71] font-black text-2xl w-16 shrink-0">100%</div>
                  <div class="text-blue-100 text-sm leading-snug">prirodnog porijekla aktivne tvari</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST SECTION -->
  <section id="povjerenje" class="py-24 bg-gradient-to-br from-slate-50 to-blue-50/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-[#2ECC71] font-bold text-sm uppercase tracking-widest mb-3">Povjerenje i kvaliteta</p>
        <h2 class="text-4xl sm:text-5xl font-black text-slate-900 tracking-tight">Zašto Hrvati<br />biraju Imunosal®</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6 mb-12">
        <div class="bg-white rounded-2xl border border-slate-200 p-8 text-center shadow-sm hover:shadow-md transition-shadow">
          <div class="text-5xl mb-4">🏆</div>
          <div class="font-black text-[#1B4F8A] text-3xl mb-2">#1</div>
          <h3 class="font-bold text-slate-800 mb-2">IQVIA podaci</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Najprodavaniji brand dodataka prehrani za imunitet u hrvatskim ljekarnama &mdash; 2020. i 2021. godina.</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 p-8 text-center shadow-sm hover:shadow-md transition-shadow">
          <div class="text-5xl mb-4">🇭🇷</div>
          <div class="font-black text-[#1B4F8A] text-3xl mb-2">HR</div>
          <h3 class="font-bold text-slate-800 mb-2">Hrvatski brand</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Imunosal® je ponos tvrtke PHARMOVAL® &mdash; hrvatski brand koji brine o zdravlju hrvatskih obitelji.</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 p-8 text-center shadow-sm hover:shadow-md transition-shadow">
          <div class="text-5xl mb-4">💊</div>
          <div class="font-black text-[#1B4F8A] text-3xl mb-2">SVE</div>
          <h3 class="font-bold text-slate-800 mb-2">Ljekarničko povjerenje</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Dostupan u svim ljekarnama diljem Hrvatske i na online platformi drogerija.hr.</p>
        </div>
      </div>

      <div class="bg-[#1B4F8A] rounded-2xl p-8 flex flex-col sm:flex-row items-center gap-6 text-center sm:text-left">
        <div class="w-16 h-16 rounded-xl bg-white/15 flex items-center justify-center shrink-0 text-3xl">⚗️</div>
        <div class="flex-1">
          <div class="text-[#2ECC71] font-bold text-xs uppercase tracking-widest mb-1">Proizvođač</div>
          <h3 class="text-white font-black text-xl mb-1">PHARMOVAL®</h3>
          <p class="text-blue-200 text-sm">Hrvatska farmaceutska tvrtka s dugogodišnjim iskustvom u razvoju i distribuciji visokokvalitetnih dodataka prehrani i lijekova.</p>
        </div>
        <a
          href="https://www.drogerija.hr"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 bg-white text-[#1B4F8A] hover:bg-blue-50 font-bold px-6 py-3 rounded-xl transition-colors text-sm"
        >
          Kupi online &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- SOCIAL / CTA BAND -->
  <section class="py-20 bg-gradient-to-r from-[#2ECC71] to-[#27ae60]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-black text-white mb-4 tracking-tight">Pratite nas na društvenim mrežama</h2>
      <p class="text-green-100 mb-8 max-w-lg mx-auto">Ostanite u toku s najnovijim savjetima, vijestima i promocijama iz Imunosal® zajednice.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="https://www.facebook.com/imunosal.hr"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-white/20 hover:bg-white/30 border border-white/30 text-white font-semibold px-5 py-2.5 rounded-xl transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          Facebook
        </a>
        <a
          href="https://www.instagram.com/imunosal_hr"
          target="_blank"
          rel="noopener noreferrer"
